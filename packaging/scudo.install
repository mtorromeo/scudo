post_install() {
    cat <<'EOF'
==> Network policies finer than "no network at all" are enforced by scudo-bpfd:

      systemctl --user enable --now scudo-bpfd.socket

    Without it, a profile with a [profile.network] section refuses to run the
    command rather than running it unfiltered.

==> To dispatch commands through scudo automatically, either symlink them to
    /usr/bin/scudo or start the FUSE shim:

      systemctl --user enable --now scudo-fuse.service
EOF
}

post_upgrade() {
    cat <<'EOF'
==> Restart the daemon to pick up the new version:

      systemctl --user restart scudo-bpfd.socket scudo-bpfd.service
EOF
}
